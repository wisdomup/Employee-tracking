PORT=8001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gps_task_tracking
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h
UPLOAD_PATH=./uploads

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FRONTEND_URL=http://localhost:5001

# Business timezone for DAY boundaries in the region-sales and rider-collection reports.
# Every "today", day-end and date-range edge is a boundary in THIS zone, not UTC — at UTC+5 a
# delivery at 02:00 local would otherwise be reported on the previous day and a rider's day-end
# would not reconcile with the cash in his pocket. Defaults to Asia/Karachi.
# REPORT_TIMEZONE=Asia/Karachi

# Daily visit generation at start of day (routes with assigned employee + dealers)
# VISIT_CRON_ENABLED=false
# Midnight in the timezone below; omit Friday (0,1,2,3,4,6 = Sun–Thu and Sat)
# VISIT_CRON_SCHEDULE=0 0 * * 0,1,2,3,4,6
# VISIT_CRON_TIMEZONE=UTC
# Optional testing only: if VISIT_CRON_SCHEDULE is unset, daily at server start + N minutes
# VISIT_CRON_STARTUP_OFFSET_MINUTES=7

# Rider late-start freeze: an order_taker must check in at their FIRST shop by this
# wall-clock time or the account is frozen until an admin unfreezes it. Riders with no
# assigned visits that day are exempt. HH:MM, 24-hour; a malformed value stops the sweep
# from starting rather than freezing everyone at the wrong time.
# RIDER_FIRST_VISIT_DEADLINE=12:30
# Zone the deadline above is a wall-clock time in. Falls back to REPORT_TIMEZONE.
# RIDER_FREEZE_TIMEZONE=Asia/Karachi
# The sweep that catches riders who never showed up at all. Defaults to the deadline plus
# 5 minutes, every day except Friday. Set to false to disable freezing no-shows.
# LATE_START_CRON_ENABLED=false
# LATE_START_CRON_SCHEDULE=35 12 * * 0,1,2,3,4,6
