{
  "name": "wisdomup-express",
  "version": "1.0.0",
  "description": "Wisdomup API — Express.js rewrite",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test:visits": "ts-node -T src/modules/visits/visits.rules.test.ts",
    "test:visits:flow": "ts-node -T src/modules/visits/visits.flow.test.ts",
    "test:visits:orders": "ts-node -T src/modules/visits/visits.orders.flow.test.ts",
    "test:freeze": "ts-node -T src/modules/account-freeze/account-freeze.rules.test.ts",
    "test:freeze:flow": "ts-node -T src/modules/account-freeze/account-freeze.flow.test.ts",
    "test:analytics": "ts-node -T src/modules/analytics/analytics.rules.test.ts",
    "test:analytics:flow": "ts-node -T src/modules/analytics/analytics.flow.test.ts",
    "test:city-scope": "ts-node -T src/modules/dealers/dealers.city-scope.test.ts",
    "test:dashboard": "ts-node -T src/modules/dashboard/dashboard.flow.test.ts",
    "test:region-sales": "ts-node -T src/modules/region-sales/region-sales.rules.test.ts",
    "test:region-sales:flow": "ts-node -T src/modules/region-sales/region-sales.flow.test.ts",
    "test:collections": "ts-node -T src/modules/collections/collections.rules.test.ts",
    "test:collections:flow": "ts-node -T src/modules/collections/collections.flow.test.ts",
    "test:collections:report": "ts-node -T src/modules/collections/collections.report.test.ts",
    "test:collections:api": "ts-node -T src/modules/collections/collections.api.test.ts",
    "test:orders:stock": "ts-node -T src/modules/orders/orders.stock-lifecycle.test.ts",
    "test:orders:totals": "ts-node -T src/modules/orders/orders.totals.test.ts",
    "test:orders:punch-location": "ts-node -T src/modules/orders/orders.punch-location.test.ts",
    "test:stock-costing": "ts-node -T src/modules/warehouse/stock-costing.test.ts",
    "test:stock-ledger": "ts-node -T src/modules/warehouse/stock-ledger.flow.test.ts",
    "test:warehouse-resolver": "ts-node -T src/modules/warehouse/warehouse-resolver.test.ts",
    "test:warehouse-flow": "ts-node -T src/modules/warehouse/warehouse.flow.test.ts",
    "test:transfers": "ts-node -T src/modules/warehouse/transfers.rules.test.ts",
    "test:stock-count": "ts-node -T src/modules/warehouse/stock-count.flow.test.ts",
    "test:stock-adjust": "ts-node -T src/modules/warehouse/stock-adjustments.flow.test.ts",
    "test:stock-matrix": "ts-node -T src/modules/warehouse/stock-matrix.flow.test.ts",
    "test:swagger": "ts-node -T src/config/swagger.test.ts",
    "test:migrate:warehouse": "ts-node -T src/database/migrations/warehouse-stock-bootstrap.test.ts",
    "test:migrate:warehouse-run": "ts-node -T src/database/migrations/warehouse-bootstrap-run.test.ts",
    "test": "npm run test:finance && npm run test:finance:flow && npm run test:finance:posting && npm run test:finance:sales && npm run test:finance:settlements && npm run test:finance:inventory && npm run test:finance:reconcile && npm run test:permissions && npm run test:permissions:parity && npm run test:permissions:flow && npm run test:swagger && npm run test:visits && npm run test:freeze && npm run test:freeze:flow && npm run test:analytics && npm run test:region-sales && npm run test:collections && npm run test:stock-costing && npm run test:visits:flow && npm run test:visits:orders && npm run test:analytics:flow && npm run test:city-scope && npm run test:dashboard && npm run test:region-sales:flow && npm run test:collections:flow && npm run test:collections:report && npm run test:collections:api && npm run test:orders:stock && npm run test:orders:totals && npm run test:orders:punch-location && npm run test:stock-ledger && npm run test:warehouse-resolver && npm run test:warehouse-flow && npm run test:transfers && npm run test:stock-count && npm run test:stock-adjust && npm run test:stock-matrix && npm run test:migrate:warehouse && npm run test:migrate:warehouse-run && npm run test:products:picker",
    "migrate:fix-task-ids": "ts-node src/database/migrations/fix-task-ids.ts",
    "migrate:fix-taskid-types": "ts-node src/database/migrations/fix-taskid-types.ts",
    "migrate:update-assignment-status": "ts-node src/database/migrations/update-assignment-status.ts",
    "migrate:route-text-fields": "ts-node src/database/migrations/route-text-fields.ts",
    "migrate:task-default-route": "ts-node src/database/migrations/task-default-route.ts",
    "migrate:update-admin-email": "ts-node src/database/migrations/update-admin-email.ts",
    "migrate:warehouse-bootstrap": "ts-node -T src/database/migrations/warehouse-stock-bootstrap.ts",
    "reconcile:stock": "ts-node -T src/database/migrations/reconcile-stock-mirror.ts",
    "sandbox": "ts-node -T src/database/seeds/dev-sandbox.ts",
    "seed:admin": "ts-node src/database/seeds/admin.seed.ts",
    "seed:full": "ts-node src/database/seeds/full.seed.ts",
    "test:permissions": "ts-node -T src/modules/permissions/permissions.rules.test.ts",
    "seed:access": "ts-node -T src/database/seeds/run-access-seed.ts",
    "test:permissions:parity": "ts-node -T src/modules/permissions/permissions.parity.test.ts",
    "test:permissions:flow": "ts-node -T src/modules/permissions/permissions.flow.test.ts",
    "test:products:picker": "ts-node -T src/modules/products/products.picker.test.ts",
    "dev:sandbox": "node -e \"process.env.MONGODB_URI='mongodb://127.0.0.1:27018/sandbox';require('child_process').spawn('npm',['run','dev'],{stdio:'inherit',shell:true})\"",
    "test:finance": "ts-node -T src/modules/finance/finance.rules.test.ts",
    "test:finance:flow": "ts-node -T src/modules/finance/finance.chart.flow.test.ts",
    "test:finance:posting": "ts-node -T src/modules/finance/finance.posting.flow.test.ts",
    "test:finance:sales": "ts-node -T src/modules/finance/finance.sales-posting.flow.test.ts",
    "test:finance:settlements": "ts-node -T src/modules/finance/finance.settlement-posting.flow.test.ts",
    "test:finance:inventory": "ts-node -T src/modules/finance/finance.inventory-posting.flow.test.ts",
    "test:finance:reconcile": "ts-node -T src/modules/finance/finance.reconciliation.flow.test.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.13",
    "sanitize-html": "^2.17.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.2.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
